# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# AWS credentials are NOT set here - use `aws configure` or environment variables.

aws_region          = "us-east-1"
project_name        = "spendwise"
environment         = "dev"
vpc_cidr            = "10.20.0.0/16"
az_count            = 2
# EKS is billed hourly and blocked on AWS Free-plan accounts.
# false = create only the (free) VPC + public subnets; true = also create EKS.
create_eks          = false
cluster_name        = "spendwise-eks"
kubernetes_version  = "1.33"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3

# IAM ARN of the user/role whose keys are stored in GitHub secrets (optional)
ci_deployer_arn = ""
